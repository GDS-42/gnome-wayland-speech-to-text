msgid "Keys were still held down, so the text was not pasted."
msgstr "Des touches étaient encore enfoncées : le texte n’a pas été collé."

#: greffier/desktop/injection.py:611
msgid ""
"No clipboard access (install wl-clipboard or the extension): the text was "
"typed instead."
msgstr ""
"Pas d’accès au presse-papiers (installez wl-clipboard ou l’extension) : le "
"texte a été saisi au clavier à la place."

#: greffier/desktop/injection.py:627
msgid "The clipboard could not be set: the text was typed instead."
msgstr ""
"Impossible de remplir le presse-papiers : le texte a été saisi au clavier à "
"la place."

