msgid ""
"Inserting the text took too long. The text is in the clipboard: press Ctrl+V "
"to paste it."
msgstr ""
"L’insertion du texte a pris trop de temps. Le texte est dans le presse-"
"papiers : appuyez sur Ctrl+V pour le coller."

#: greffier/desktop/injection.py:460
msgid "Inserting the text took too long and was abandoned."
msgstr "L’insertion du texte a pris trop de temps et a été abandonnée."

#: greffier/desktop/injection.py:507
msgid "The screen is locked."
msgstr "L’écran est verrouillé."

#: greffier/desktop/injection.py:520
msgid ""
"Could not copy the text: install wl-clipboard or enable the Greffier GNOME "
"Shell extension."
msgstr ""
"Impossible de copier le texte : installez wl-clipboard ou activez l’extension"
" GNOME Shell de Greffier."

#: greffier/desktop/injection.py:525
msgid "Text copied to the clipboard: press Ctrl+V to paste it."
msgstr ""
"Texte copié dans le presse-papiers : appuyez sur Ctrl+V pour le coller."

